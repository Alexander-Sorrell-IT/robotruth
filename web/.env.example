# Set these on Vercel (Project Settings -> Environment Variables).
NEXT_PUBLIC_API_BASE=   # deployed API URL, e.g. https://robotruth-api.up.railway.app
NEXT_PUBLIC_SITE_URL=   # deployed web URL, e.g. https://robotruth.vercel.app  (fixes OG image URLs)
NEXT_PUBLIC_NOVUS_SITE_ID=   # leave blank until Novus access lands; setting it activates the Novus forwarder (see lib/novus.ts). Funnel works without it.
